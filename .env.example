# ─────────────────────────────────────────────────────────────────
# SRV Detailing — Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# NEVER commit .env.local to Git.
# Add the same keys in Netlify: Site → Site configuration → Environment variables
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://kjbcgucumyszdflywdha.supabase.co

# Service Role key — SERVER ONLY. Never expose to the browser.
# Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email notifications (optional) ───────────────────────────────
# Resend API key — admin receives an email whenever a booking is submitted.
# Sign up free at https://resend.com (100 emails/day free tier).
# If not set, email notifications are simply skipped; bookings still save.
RESEND_API_KEY=your-resend-api-key-here
